# CAD Serviceability Environment Configuration Example

APP_NAME="CAD Serviceability Assessment System"
APP_VERSION="0.2.0"
DEBUG=false

# Database Configuration
DATABASE_URL="sqlite:///./cad_serviceability.db"

# Storage & File Directories
UPLOAD_DIR="../uploads"
TEST_DATA_DIR="test_data"
MAX_UPLOAD_SIZE_MB=100

# Tessellation Quality Settings (smaller = finer mesh, higher fidelity)
TESSELLATION_LINEAR_DEFLECTION=0.5
TESSELLATION_ANGULAR_DEFLECTION=0.1

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"
