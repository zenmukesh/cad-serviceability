# Root .gitignore for CAD Serviceability Assessment System

# Python & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
var/
wheels/

# Virtual Environments
.venv/
venv/
env/
ENV/

# Database files
*.db
*.sqlite
*.sqlite3
test_cad_serviceability.db

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
*.tsbuildinfo
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Runtime Uploads & Generated temp files
uploads/*
!uploads/.gitkeep

# IDE & Editor Settings
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
